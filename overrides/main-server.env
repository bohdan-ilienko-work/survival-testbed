# Mounted over /home/server/.env inside the main-server container.
#
# WHY: ../battleofgeniuses/main-server/.env is whitelisted by that service's
# .dockerignore, so it is baked into the image, and main-server/server.js calls
# require("dotenv").config(). That checked-in file contains
#   DB_URL=mongodb://95.216.114.174:27022
# a REMOTE database. dotenv does not override variables that already exist in
# the process environment (compose sets them all), but "does not override" is a
# library behaviour, not a guarantee we want to bet a production DB on.
# Mounting this file over it removes the remote host from the container entirely.

DB_URL=mongodb://mongo:27017
DB_NAME=quizdb
AUTH_JWT_PRIVATE_KEY_PATH=./keys/auth.key
AUTH_JWT_PUBLIC_KEY_PATH=./keys/auth.key.pub.pem
AUTH_JWT_ALGORITHM=RS256
