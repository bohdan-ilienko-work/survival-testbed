###############################################################################
# survival-testbed — LOCAL ONLY environment
#
# HARD RULE: every host in this file is either a docker-compose service name or
# localhost. Nothing here may ever point at 165.227.143.145, 176.9.78.228,
# 95.216.114.174 or any other remote host. If you copy a value from
# ../battleofgeniuses/.env.dev, rewrite the host first.
###############################################################################

COMPOSE_PROJECT_NAME=survival-testbed

# ---------- MONGO (local container only) -------------------------------------
# Bare URL (no db name) — services append their own db name.
DB_URL=mongodb://mongo:27017
MONGO_URI=mongodb://mongo:27017
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_HOST_PORT=27077

DB_NAME=quizdb
MAIN_SERVER_DB_NAME=quizdb
FIGHT_SERVER_DB_NAME=quizdb
QUESTIONS_DB_NAME=questions_db
SURVIVAL_DB_NAME=survival_db
WINRATE_DB_NAME=questions_db

# chrono facts minigame — the local mongo container already holds chrono_db
# (empty CHRONO_DB_URL == off, and CHRONO rounds fall back to QUESTION)
CHRONO_DB_URL=mongodb://mongo:27017
CHRONO_DB_NAME=chrono_db

# ---------- SHARED SECRETS ----------------------------------------------------
# docker-compose.yml passes this to questions-api (which gates /internal/*), survival-server
# (which sends it as x-internal-token) and main-server, so all three must read the same value.
# Local-only, but still ≥32 chars: questions-api warns at startup below that. Regenerate
# with `openssl rand -hex 32`; never reuse the dev or prod token here.
INTERNAL_API_TOKEN=38e4c096a71b1a5abd42425789cfd2cf2a8a9e5e35b24ab4ee69497c8d2e62c6

# ---------- HOST PORT MAP -----------------------------------------------------
# 7000 on macOS is taken by the AirPlay Receiver (ControlCenter). We publish
# main-server on 127.0.0.1:7000 (a specific-address bind wins over AirPlay's
# wildcard bind) AND on 7010 as a conflict-proof alternative.
MAIN_SERVER_HOST_PORT=7010
FIGHT_SERVER_HOST_PORT=7777
SURVIVAL_SERVER_HOST_PORT=4001
SURVIVAL_SERVER_GRPC_HOST_PORT=5010
QUESTIONS_API_WEB_HOST_PORT=3001
QUESTIONS_API_GAME_HOST_PORT=5556

# ---------- QUESTIONS API -----------------------------------------------------
QUESTIONS_API_WEB_PORT=3001
QUESTIONS_API_GAME_PORT=5556
QUESTION_SERVER_HOST=questions-api
QUESTION_SERVER_WEB_PORT=3001
QUESTION_SERVER_GRPC_PORT=5556
QUESTION_API_URL=http://localhost:3001
EDITOR_SESSION_TIMEOUT=3600000
# Third-party integrations are intentionally stubbed: the testbed must not talk
# to Gmail / Tinify / SerpAPI. envalid only requires the vars to be non-empty.
GMAIL_CLIENT_ID=testbed-disabled
GMAIL_CLIENT_SECRET=testbed-disabled
GMAIL_REFRESH_TOKEN=testbed-disabled
ADMIN_EMAIL=testbed@localhost.local
TINIFY_API_KEY=testbed-disabled
SERP_API_KEY=testbed-disabled

# ---------- MAIN SERVER -------------------------------------------------------
MAIN_SERVER_CLIENTS_PORT=7000
MAIN_SERVER_CLIENTS_LOCAL_PORT=7000
MAIN_SERVER_CLIENTS_EXTERNAL_PORT=7010
MAIN_SERVER_RPC_USE_TLS=
MAIN_SERVER_GRPC_PORT_FOR_FIGHT=5555
MAIN_SERVER_GRPC_PORT_FOR_TOURNAMENT=5558
MAIN_SERVER_GRPC_PORT_FOR_ACADEMY=5557
MAIN_SERVER_GRPC_PORT_FOR_SURVIVAL=5012
MAIN_SERVER_NODE_ENV=development
AUTH_JWT_PUBLIC_KEY_PATH=./keys/auth.key.pub.pem
AUTH_JWT_PRIVATE_KEY_PATH=./keys/auth.key
AUTH_JWT_ALGORITHM=RS256
ACADEMY_API_CLIENT_URL=http://localhost:9000
# bots: the fight-bot service is NOT part of this testbed, keep it off so
# main-server does not spin trying to reach a bot server that does not exist.
ENABLE_BOTS=false
SOLO_BOT_TIMEOUT_MS=1000
BOTS_SERVER_ADDRESS=fight-bot-server:50051
MM_TEAM_SEARCH_TO_SOLO_MS=
MM_SOLO_BOT_DELAY_MS=
MM_TEAM_ITERATION_MS=
MM_TEAM_BOT_DELAY_MS=
MM_PARTY_BOT_DELAY_MS=

# ---------- FIGHT SERVER ------------------------------------------------------
FIGHT_SERVER_HOST=fight-server
FIGHT_SERVER_GRPC_PORT=5555
FIGHT_SERVER_CLIENTS_PORT=7777
FIGHT_SERVER_CLIENTS_LOCAL_PORT=7777
FIGHT_SERVER_CLIENTS_EXTERNAL_PORT=7777
# host list handed to the client so it knows where to connect — LOCAL only
FIGHT_SERVER_CLIENTS_HOSTS=127.0.0.1
FIGHT_SERVER_MAIN_SERVER_HOST=main-server
FIGHT_SERVER_MAIN_SERVER_GRPC_PORT=5555
WIN_RATE_SERVER_HOST=winrate-microservice
WIN_RATE_SERVER_GRPC_PORT=6666
BOTS_HANDLER_SERVER_HOST=fight-bot-server
BOTS_HANDLER_SERVER_GRPC_PORT=50051
FACTS_FORCE=

# ---------- SURVIVAL SERVER ---------------------------------------------------
SURVIVAL_SERVER_HOST=survival-server
SURVIVAL_SERVER_CLIENTS_HOSTS=127.0.0.1
SURVIVAL_SERVER_CLIENTS_LOCAL_PORT=4001
SURVIVAL_SERVER_CLIENTS_EXTERNAL_PORT=4001
SURVIVAL_SERVER_GRPC_PORT=5010

# ---------- SURVIVAL TUNABLES (fast local match) ------------------------------
# see SURVIVAL_FIX_SPEC.md §2 — survival-server/src/common.ts reads exactly these
SURVIVAL_INSTANT_START=true
SURVIVAL_MIN_PLAYERS=8
SURVIVAL_ONBOARDING_MS=90000
SURVIVAL_ROUND_MS=20000
SURVIVAL_BUYBACK_MS=10000
SURVIVAL_ROUND_START_DELAY_MS=2000  # ІНЕРТНИЙ: вікно байбека тепер САМЕ Є паузою між раундами
SURVIVAL_START_HOUR_UTC=17
SURVIVAL_DISCONNECT_GRACE_MS=30000
SURVIVAL_MAX_ROUNDS=60
SURVIVAL_BOT_ACCURACY=0.6
# ранні боти: 3-4 одразу при відкритті лоббі, 1-3 на кожен людський джойн з шансом 0.5
SURVIVAL_BOT_SEED_MIN=3
SURVIVAL_BOT_SEED_MAX=4
SURVIVAL_BOT_PER_JOIN_MIN=1
SURVIVAL_BOT_PER_JOIN_MAX=3
SURVIVAL_BOT_PER_JOIN_CHANCE=0.5
# скільки мс після фіналу connect ще віддає lastResult (фінальну таблицю)
SURVIVAL_LAST_RESULT_WINDOW_MS=120000
SURVIVAL_CHRONO_EVENTS_PER_ROUND=4

# ---------- GATEWAY (survival-testbed/gateway, run on the host) ---------------
# The gateway talks JSTP to the published host ports above.
GATEWAY_PORT=8787
GATEWAY_MAIN_SERVER_HOST=127.0.0.1
GATEWAY_MAIN_SERVER_PORT=7000
GATEWAY_FIGHT_SERVER_PORT=7777
GATEWAY_SURVIVAL_SERVER_PORT=4001

# testbed: default is 4, which makes BuyBack unreachable in a small lobby
SURVIVAL_BUYBACK_MIN_PLAYERS_REQUIRED=1

# how long the lobby stays open under INSTANT_START — long enough to open more tabs
SURVIVAL_INSTANT_ONBOARDING_MS=30000
